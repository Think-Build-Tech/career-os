APP_NAME=careeros-ai-framework
APP_ENV=development
DEBUG=true

# Local Postgres values; Docker Compose overrides these automatically.
AURORA_DB_HOST=localhost
AURORA_DB_PORT=5432
AURORA_DB_USER=postgres
AURORA_DB_PASSWORD=admin
AURORA_DB_NAME=careeros_dev
AURORA_DB_SSLMODE=disable

AI_SERVICE_API_KEYS=careeros-api=local-dev-careeros-ai-token
LLM_PROVIDER=bedrock
BEDROCK_API_KEY=replace-me
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=replace-me
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
